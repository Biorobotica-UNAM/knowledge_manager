<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>knowledge_manager</name>
  <version>0.0.0</version>
  <description>
    ROS2 node that maintains the robot world state as a blackboard.
    Exposes /world/get_state and /world/update_state services.
    Loads static vocabulary from knowledge_bank/keys/ and persists
    runtime state to knowledge_bank/volatile/runtime.yaml.
  </description>
  <maintainer email="jorge.martinezram@ingenieria.unam.edu">fidel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>knowledge_interfaces</depend>
  <depend>nlohmann_json</depend>
  <depend>ament_index_cpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
